{
  "name": "chat-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run build:web && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "sim": "tsx src/sim/index.ts",
    "demo": "npm run build:web && tsx scripts/demo.ts",
    "build:web": "tsc -p web/tsconfig.json",
    "pretest": "npm run build:web"
  },
  "dependencies": {
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
