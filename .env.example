# Create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Broadcaster login, lowercase, without @ or URL
TWITCH_CHANNEL=
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
PORT=3000
# Explicit provider selection; missing selected key disables radar, with no fallback.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=30000
ANTHROPIC_API_KEY=
# For OpenAI, set LLM_PROVIDER=openai and LLM_MODEL=gpt-4.1-mini.
OPENAI_API_KEY=
# Legacy model variable used only when LLM_MODEL is blank and OpenAI is selected.
OPENAI_MODEL=gpt-4.1-mini
